# model config
# PROVIDER defaults to groq (it has a usable free tier). Set PROVIDER=mock for a
# fully offline run. Supported: groq, anthropic, openai, mock.
PROVIDER=
# Model id is provider-specific. Leave blank and each provider uses its own
# default (groq: llama-3.3-70b-versatile, anthropic: claude-sonnet-4-5,
# openai: gpt-4.1). Set it to override.
MODEL_ID=
TEMPERATURE=0.0
SEED=
MAX_TOKENS=2048

# cost/budget
MAX_COST_USD=10.0

# experiment
# Replicates per (task, condition). This is a preregistered sample size, so it is
# deliberately not changed for smoke tests. For a small run, pass --trials
# explicitly instead of editing this: pilot study1-run --tasks t01,t07 --trials 3
N_TRIALS=20
MAX_REPAIR_ROUNDS=3

# sandbox
DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_S=120
SANDBOX_MEM_LIMIT_MB=512
SANDBOX_CPU_LIMIT=1.0

# api keys (env only, never logged, never a CLI flag -- argv is visible in ps)
# Only the key for the provider you selected is needed.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# optional: route a provider through a proxy or gateway. This redirects that
# provider's API key to whatever host you name. A host that is not the
# provider's official one is REFUSED (exit 4) unless you pass
# --allow-custom-base-url or set ALLOW_CUSTOM_BASE_URL below -- and when you do,
# the override is recorded in every trial's provenance. Leave unset unless you
# need it.
# GROQ_BASE_URL=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=

# opt in to a non-official *_BASE_URL from config rather than per-command.
# Accepted values: 1/true/yes/on. Recorded in provenance either way; default off.
ALLOW_CUSTOM_BASE_URL=0

# retry policy -- not settable by env; the defaults live in
# src/pilot/models/http.py (max_attempts=4, backoff from 1.0 s, Retry-After cap
# 60 s). Only 429 and 5xx are retried: timeouts and other 4xx are permanent,
# because a request with no status may already have been served. When retries run
# out the trial is recorded UNGRADED with reason rate_limited -- never a failure
# and never a zero -- and a resumed run retries those first. Retry-After is
# untrusted remote input, so it is capped; an uncapped 86400 would stall a run.
