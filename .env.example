# model config
# PROVIDER defaults to groq (it has a usable free tier). Set PROVIDER=mock for a
# fully offline run. Supported: groq, anthropic, openai, mock.
PROVIDER=
# Model id is provider-specific. Leave blank and each provider uses its own
# default (groq: llama-3.3-70b-versatile, anthropic: claude-sonnet-4-5,
# openai: gpt-4.1). Set it to override.
MODEL_ID=
TEMPERATURE=0.0
SEED=
MAX_TOKENS=2048

# cost/budget
MAX_COST_USD=10.0

# experiment
N_TRIALS=20
MAX_REPAIR_ROUNDS=3

# sandbox
DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_S=120
SANDBOX_MEM_LIMIT_MB=512
SANDBOX_CPU_LIMIT=1.0

# api keys (env only, never logged, never a CLI flag -- argv is visible in ps)
# Only the key for the provider you selected is needed.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# optional: route a provider through a proxy or gateway. This redirects that
# provider's API key to whatever host you name; the pilot prints a warning when
# the host is not the provider's official one. Leave unset unless you need it.
# GROQ_BASE_URL=
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=